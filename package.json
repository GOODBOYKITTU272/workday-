{
  "name": "applywizz-workday-automation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "corepack pnpm --recursive --if-present run build",
    "dev:mobile": "corepack pnpm --filter @applywizz/mobile-web start",
    "dev:worker": "corepack pnpm --filter @applywizz/worker dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "corepack pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.0"
  }
}
